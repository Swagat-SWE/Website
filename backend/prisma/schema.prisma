generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  role      Role     @default(USER)
}

model Guest {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

enum Role {
  USER
  STAFF
}
